# Copy to .env (gitignored) and fill in locally. Never commit real values.
# The harness reads this only from the process environment; nothing here is
# ever written into artifacts.
TYPESAFE_API_KEY=placeholder-not-a-real-key
TYPESAFE_BASE_URL=https://api.typesafe.ai

# Explicit opt-in required before any live paid request can be dispatched.
# Milestone 4 gate (DESIGN.md §12). Leave unset for offline work.
JEVO_ALLOW_LIVE=0